# ---------------------------------------------------------------------------
# BUSLA — example environment. Copy to `.env` and fill in real values.
# Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Django / API ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-dev-and-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

# --- Database (PostGIS) ---
POSTGRES_DB=busla
POSTGRES_USER=busla
POSTGRES_PASSWORD=busla
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full URL form (GeoDjango): postgis://user:pass@host:port/db
DATABASE_URL=postgis://busla:busla@db:5432/busla

# --- Redis (Channels layer + Celery broker/result + cache) ---
REDIS_URL=redis://redis:6379/0
CHANNELS_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# --- Auth (JWT) ---
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# --- Google Maps (SEPARATE keys — least privilege) ---
# Server-side key: restricted to Distance Matrix + Geocoding APIs, IP-restricted.
GOOGLE_MAPS_SERVER_KEY=
# Client keys: HTTP-referrer restricted (web) / app-restricted (mobile).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
FLUTTER_GOOGLE_MAPS_KEY=

# --- Firebase Cloud Messaging (push) ---
FCM_CREDENTIALS_PATH=/run/secrets/fcm-service-account.json

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Optimizer ---
BUSLA_OPTIMIZER=busla.routing.optimizers.OrToolsOptimizer
OPTIMIZER_TIME_LIMIT_SEC=30
