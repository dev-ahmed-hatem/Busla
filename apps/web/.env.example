# ---------------------------------------------------------------------------
# BUSLA web admin — environment. Copy to `.env.local` and adjust as needed.
# Next.js auto-loads .env / .env.local from THIS directory (apps/web), not the
# repo root. `.env.local` is gitignored; never commit real values.
#
# NEXT_PUBLIC_* vars are inlined into the client bundle at BUILD time — after
# changing them, restart `next dev` / rebuild for the change to take effect.
# ---------------------------------------------------------------------------

# Django REST API origin the BROWSER calls (must be reachable from the client).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Django origin the NEXT SERVER calls for the auth BFF (server→API hop).
# Defaults to NEXT_PUBLIC_API_URL when unset; override for split deploys.
API_INTERNAL_URL=http://localhost:8000

# WebSocket origin (realtime; unused while liveness is polling-based).
NEXT_PUBLIC_WS_URL=ws://localhost:8000
