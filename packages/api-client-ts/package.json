    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "@busla/config-ts": "*",
    "@busla/config-eslint": "*",
    "typescript": "^5.7.2",
    "eslint": "^9.17.0"
  }
}
